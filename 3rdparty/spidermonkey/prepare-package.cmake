# This helper runs only inside the AX_ENABLE_EXT_JS third-party branch.
macro(_ax_sm_resolve_package)
  set(AX_JS_SPIDERMONKEY_ROOT "" CACHE PATH "Explicit SpiderMonkey 33.1 package override (never built or overwritten)")
  set(AX_JS_SPIDERMONKEY_CACHE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../cache/js-runtime" CACHE PATH "SpiderMonkey source, tools and package cache")
  option(AX_JS_SPIDERMONKEY_AUTO_BUILD "Prepare the default SpiderMonkey package automatically when missing" ON)
  option(AX_JS_SPIDERMONKEY_OFFLINE "Require cached SpiderMonkey source and build tools" OFF)
  set(AX_JS_SPIDERMONKEY_BUILD_JOBS "2" CACHE STRING "Parallel jobs for the isolated SpiderMonkey build")
  get_filename_component(_sm_cache "${AX_JS_SPIDERMONKEY_CACHE_DIR}" ABSOLUTE)
  if(AX_JS_SPIDERMONKEY_ROOT)
    get_filename_component(_sm_package_root "${AX_JS_SPIDERMONKEY_ROOT}" ABSOLUTE)
    set(_sm_explicit_root TRUE)
  else()
    set(_sm_package_root "${_sm_cache}/packages/${_sm_platform}-${_sm_arch}")
    set(_sm_explicit_root FALSE)
  endif()

  # Validate the application's Android ABI before any download/bootstrap work.
  # CMAKE_ANDROID_NDK_VERSION omits the patch revision identifying r27d.
  if(ANDROID)
    if(NOT EXISTS "${CMAKE_ANDROID_NDK}/source.properties")
      message(FATAL_ERROR "Cannot validate the Android NDK: source.properties is missing.")
    endif()
    file(STRINGS "${CMAKE_ANDROID_NDK}/source.properties" _sm_ndk_revision_line REGEX "^Pkg\\.Revision[ \t]*=")
    string(REGEX REPLACE "^Pkg\\.Revision[ \t]*=[ \t]*([^ \t\r\n]+)[ \t]*$" "\\1" _sm_ndk_revision "${_sm_ndk_revision_line}")
    if(NOT _sm_ndk_revision STREQUAL "27.3.13750724")
      message(FATAL_ERROR "SpiderMonkey's Android package requires NDK r27d (27.3.13750724), found ${_sm_ndk_revision}.")
    endif()
    if((DEFINED ANDROID_STL AND NOT ANDROID_STL STREQUAL "c++_shared") OR
       (DEFINED CMAKE_ANDROID_STL_TYPE AND NOT CMAKE_ANDROID_STL_TYPE STREQUAL "c++_shared"))
      message(FATAL_ERROR "SpiderMonkey requires c++_shared to share the C++ ABI with Axmol.")
    endif()
    set(_sm_android_api "${CMAKE_SYSTEM_VERSION}")
    if(DEFINED ANDROID_PLATFORM_LEVEL)
      set(_sm_android_api "${ANDROID_PLATFORM_LEVEL}")
    endif()
    if(NOT _sm_android_api MATCHES "^[0-9]+$" OR _sm_android_api LESS 23)
      message(FATAL_ERROR "SpiderMonkey requires Android API 23 or newer; selected '${_sm_android_api}'.")
    endif()
  endif()

  if(NOT EXISTS "${_sm_package_root}/manifest.json")
    if(_sm_explicit_root)
      message(FATAL_ERROR "Explicit AX_JS_SPIDERMONKEY_ROOT has no manifest.json: ${_sm_package_root}. Supply a complete source-built package or clear the override to use automatic preparation.")
    endif()
    # An existing partial package is evidence of interrupted/invalid work. Never
    # erase it or rebuild over it implicitly, including a dangling symlink.
    if(EXISTS "${_sm_package_root}" OR IS_SYMLINK "${_sm_package_root}")
      message(FATAL_ERROR "Incomplete default SpiderMonkey package: ${_sm_package_root}. Inspect and remove or relocate this partial package explicitly before retrying.")
    endif()
    if(NOT AX_JS_SPIDERMONKEY_AUTO_BUILD)
      message(FATAL_ERROR "SpiderMonkey package is missing: ${_sm_package_root}. Enable AX_JS_SPIDERMONKEY_AUTO_BUILD or run python3 3rdparty/spidermonkey/prepare.py --platform ${_sm_platform} --arch ${_sm_arch} --cache-dir \"${_sm_cache}\"; Android also requires --ndk <NDK-r27d>.")
    endif()
    if(NOT _sm_arch STREQUAL "arm64")
      message(FATAL_ERROR "Automatic SpiderMonkey preparation supports ARM64 only. Supply an existing matching package using AX_JS_SPIDERMONKEY_ROOT for historical architectures.")
    endif()
    if(NOT AX_JS_SPIDERMONKEY_BUILD_JOBS MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "AX_JS_SPIDERMONKEY_BUILD_JOBS must be a positive integer.")
    endif()
    set(_sm_prepare_args --platform "${_sm_platform}" --arch "${_sm_arch}"
      --cache-dir "${_sm_cache}" --output "${_sm_package_root}" --jobs "${AX_JS_SPIDERMONKEY_BUILD_JOBS}")
    if(ANDROID)
      list(APPEND _sm_prepare_args --ndk "${CMAKE_ANDROID_NDK}")
    else()
      set(_sm_deployment_target "${CMAKE_OSX_DEPLOYMENT_TARGET}")
      if(NOT _sm_deployment_target)
        if(_sm_platform STREQUAL "macos")
          set(_sm_deployment_target "11.0")
        else()
          set(_sm_deployment_target "15.0")
        endif()
      endif()
      if(NOT _sm_deployment_target MATCHES "^[0-9]+(\\.[0-9]+)*$")
        message(FATAL_ERROR "Invalid SpiderMonkey Apple deployment target: '${_sm_deployment_target}'.")
      endif()
      if(_sm_platform STREQUAL "macos")
        set(_sm_sdk_name macosx)
        set(_sm_lowest_target "11.0")
      elseif(_sm_platform STREQUAL "ios")
        set(_sm_sdk_name iphoneos)
        set(_sm_lowest_target "7.0")
      else()
        set(_sm_sdk_name iphonesimulator)
        set(_sm_lowest_target "14.0")
      endif()
      if(_sm_deployment_target VERSION_LESS _sm_lowest_target)
        message(FATAL_ERROR "SpiderMonkey ${_sm_platform}/arm64 requires a deployment target of at least ${_sm_lowest_target}.")
      endif()
      set(_sm_sysroot "${CMAKE_OSX_SYSROOT}")
      if(NOT _sm_sysroot)
        set(_sm_sysroot "${_sm_sdk_name}")
      endif()
      # Resolve named SDKs once and forward the selected path to the builder;
      # never let a second xcrun invocation select a different SDK implicitly.
      if(NOT IS_ABSOLUTE "${_sm_sysroot}")
        execute_process(COMMAND xcrun --sdk "${_sm_sysroot}" --show-sdk-path
          RESULT_VARIABLE _sm_sdk_result OUTPUT_VARIABLE _sm_sysroot
          ERROR_VARIABLE _sm_sdk_error OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT _sm_sdk_result EQUAL 0)
          message(FATAL_ERROR "Cannot resolve the selected SpiderMonkey Apple SDK. Check CMAKE_OSX_SYSROOT and the active Xcode installation.")
        endif()
      endif()
      get_filename_component(_sm_sdk_basename "${_sm_sysroot}" NAME)
      string(TOLOWER "${_sm_sdk_basename}" _sm_sdk_basename)
      if(NOT IS_DIRECTORY "${_sm_sysroot}" OR NOT _sm_sdk_basename MATCHES "^${_sm_sdk_name}.*\\.sdk$")
        message(FATAL_ERROR "Selected Apple SDK is missing or does not match ${_sm_platform}: ${_sm_sysroot}.")
      endif()
      list(APPEND _sm_prepare_args --deployment-target "${_sm_deployment_target}" --sysroot "${_sm_sysroot}")
    endif()
    if(AX_JS_SPIDERMONKEY_OFFLINE)
      list(APPEND _sm_prepare_args --offline)
    endif()
    find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
    set(_sm_prepare_log "${CMAKE_CURRENT_BINARY_DIR}/spidermonkey-prepare.log")
    message(STATUS "Preparing SpiderMonkey ${_sm_platform}/${_sm_arch}; log: ${_sm_prepare_log}")
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${CMAKE_CURRENT_LIST_DIR}/prepare.py" ${_sm_prepare_args}
      RESULT_VARIABLE _sm_prepare_result OUTPUT_FILE "${_sm_prepare_log}" ERROR_FILE "${_sm_prepare_log}")
    if(NOT _sm_prepare_result EQUAL 0)
      message(FATAL_ERROR "SpiderMonkey preparation failed (${_sm_prepare_result}). Full output: ${_sm_prepare_log}")
    endif()
    if(NOT EXISTS "${_sm_package_root}/manifest.json")
      message(FATAL_ERROR "SpiderMonkey preparation returned success without a package manifest. Full output: ${_sm_prepare_log}")
    endif()
  endif()
endmacro()
